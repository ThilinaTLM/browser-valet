{
  "name": "browser-valet-extension",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Thilina Lakshan <thilinalakshanmail@gmail.com>",
  "type": "module",
  "description": "Chrome extension that lets the local `bvl` CLI control this browser.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/outfit": "5.2.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.17.0",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.5"
  }
}
